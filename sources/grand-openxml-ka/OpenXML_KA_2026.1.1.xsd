    <xs:complexType name="TGsDocSignatures">
        <xs:annotation>
            <xs:documentation>
                (***) Коллекция Document.Signatures:
                For i = 0 to Document.Signatures.Count - 1
                Set row = Document.Signatures.GetItem(i)
            </xs:documentation>
            <xs:documentation>(***) row.Delete </xs:documentation>
            <xs:documentation>(***) Set row = Document.Signatures.Add </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Item" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Подпись</xs:documentation>
                    <xs:documentation>(***) row.Id </xs:documentation>
                    <xs:documentation>(***) row.Caption </xs:documentation>
                    <xs:documentation>(***) row.Value </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:complexContent>
                        <xs:extension base="TGsDocSignatureItem">
                            <xs:sequence minOccurs="0">
                                <xs:element name="Attributes">
                                    <xs:annotation>
                                        <xs:documentation>Реквизиты подписи</xs:documentation>
                                        <xs:documentation>(***) row.DeleteAttr RekId </xs:documentation>
                                        <xs:documentation>(***) row.SetAttrValue RekId, Value </xs:documentation>
                                    </xs:annotation>
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="Item" type="TGsDocSignatureItem" maxOccurs="unbounded">
                                                <xs:annotation>
                                                    <xs:documentation>Реквезит подписи</xs:documentation>
                                                </xs:annotation>
                                            </xs:element>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:extension>
                    </xs:complexContent>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
