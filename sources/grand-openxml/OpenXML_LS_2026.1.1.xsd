                                            <xs:annotation>
                                                <xs:documentation>Номер главы ССР для набора глав "Дорожное строительство"</xs:documentation>
                                                <xs:documentation>Document.CCGlavaRoad = Value</xs:documentation>
                                            </xs:annotation>
                                            <xs:simpleType>
                                                <xs:restriction base="xs:unsignedByte">
                                                    <xs:minInclusive value="1" />
                                                    <xs:maxInclusive value="15" />
                                                </xs:restriction>
