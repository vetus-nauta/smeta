                                            </xs:simpleType>
                                        </xs:attribute>
                                        <xs:attribute name="Rec" use="optional">
                                            <xs:annotation>
                                                <xs:documentation>Номер главы ССР для набора глав "Капитальный ремонт"</xs:documentation>
                                                <xs:documentation>Document.CCGlavaRec = Value</xs:documentation>
                                            </xs:annotation>
