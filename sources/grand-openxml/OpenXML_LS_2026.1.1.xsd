                                                <xs:documentation>Document.CCGlavaStd = Value</xs:documentation>
                                            </xs:annotation>
                                            <xs:simpleType>
                                                <xs:restriction base="xs:unsignedByte">
                                                    <xs:minInclusive value="1" />
                                                    <xs:maxInclusive value="15" />
