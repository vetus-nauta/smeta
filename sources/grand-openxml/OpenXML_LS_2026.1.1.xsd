                                        <xs:documentation>(***) row.DeleteAttr RekId </xs:documentation>
                                        <xs:documentation>(***) row.SetAttrValue RekId, Value </xs:documentation>
                                    </xs:annotation>
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:element name="Item" type="TGsDocSignatureItem" maxOccurs="unbounded">
                                                <xs:annotation>
                                                    <xs:documentation>Реквизит подписи</xs:documentation>
                                                </xs:annotation>
                                            </xs:element>
                                        </xs:sequence>
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:extension>
