                                                </xs:annotation>
                                                <xs:complexType>
                                                    <xs:attributeGroup ref="ACalcTableItem" />
                                                </xs:complexType>
                                            </xs:element>
                                            <xs:element name="Header" minOccurs="0" maxOccurs="unbounded">
                                                <xs:annotation>
                                                    <xs:documentation>Заголовок</xs:documentation>
