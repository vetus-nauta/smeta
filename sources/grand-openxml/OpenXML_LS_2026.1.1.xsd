                                                <xs:documentation>3</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="SB">
                                            <xs:annotation>
                                                <xs:documentation>SB - расчет в базисных ценах </xs:documentation>
                                                <xs:documentation>4</xs:documentation>
                                            </xs:annotation>
                                        </xs:enumeration>
                                        <xs:enumeration value="RS">
                                            <xs:annotation>
                                                <xs:documentation>RS - расчет ресурсным методом</xs:documentation>
                                                <xs:documentation>2</xs:documentation>
                                            </xs:annotation>
